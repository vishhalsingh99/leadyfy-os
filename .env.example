# Copy this file to .env and fill in real values from your Supabase project
# (Project Settings -> API, and Project Settings -> Database).

# --- Database (Prisma) ---
# Use the pooler for BOTH, not db.<project-ref>.supabase.co directly — that
# host is IPv6-only and unreliable in some environments.
#
# DATABASE_URL: TRANSACTION pooler (port 6543, pgbouncer) for app runtime —
# required for serverless (Vercel etc.), since session-mode pooling has a
# tiny connection cap that a serverless deployment exhausts almost
# immediately ("max clients reached in session mode"). connection_limit=10
# caps Prisma's own internal pool — a single page render here fires off
# several concurrent Prisma calls (layout actor lookup, Topbar
# notifications, the page's own Promise.all()-based data), so too low a
# limit serializes them into each other until they time out.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10"
# DIRECT_URL: SESSION pooler (port 5432, no pgbouncer) — used only by
# `prisma migrate`, which needs session-level features transaction mode
# doesn't support.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Supabase Auth ---
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"
# Server-only — bypasses RLS entirely. Never expose to the client bundle.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
